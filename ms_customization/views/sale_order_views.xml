<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Attn To" sits directly under Revision, which ms_sale_order_revision
         adds after Payment Terms - hence the dependency on that module, which
         also guarantees this view is applied after it and so can see the field.

         Shown only for the Raja group companies. The condition reads the
         order's own company, not the active one, so a Raja quotation carries
         the field whoever opens it. -->
    <record id="view_order_form_attn_to" model="ir.ui.view">
        <field name="name">sale.order.form.attn.to</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="order_revise" position="after">
                <field name="ms_is_raja_company" invisible="1"/>
                <field name="ms_attn_to_id"
                       invisible="not ms_is_raja_company"
                       options="{'no_create_edit': True}"
                       placeholder="For the attention of..."/>
            </field>
        </field>
    </record>

    <!-- "Part Number" on the order lines, for Safety Plus World only.

         The column is hidden rather than removed, so a line keeps whatever was
         typed if an order is ever moved to another company. column_invisible
         reads the ORDER's company through parent, which is why the flag lives
         on sale.order and is related down to the line for the PDF. -->
    <record id="view_order_form_part_number" model="ir.ui.view">
        <field name="name">sale.order.form.part.number</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- parent.ms_is_spw_company only resolves if the flag is in the
                 order's own view, so put it there first. -->
            <field name="partner_id" position="after">
                <field name="ms_is_spw_company" invisible="1"/>
            </field>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="ms_part_number"
                       column_invisible="not parent.ms_is_spw_company"
                       optional="show"/>
            </xpath>
            <!-- The same field in the line's own form, used on small screens
                 and when a line is opened from the list. -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="ms_part_number" invisible="not parent.ms_is_spw_company"/>
            </xpath>
        </field>
    </record>

</odoo>
