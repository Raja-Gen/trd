<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Attn To" sits directly under Revision, which ms_sale_order_revision
         adds after Payment Terms - hence the dependency on that module, which
         also guarantees this view is applied after it and so can see the field.

         Shown only for the Raja group companies. The condition reads the
         order's own company, not the active one, so a Raja quotation carries
         the field whoever opens it. -->
    <record id="view_order_form_attn_to" model="ir.ui.view">
        <field name="name">sale.order.form.attn.to</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="order_revise" position="after">
                <field name="ms_is_raja_company" invisible="1"/>
                <field name="ms_attn_to_id"
                       invisible="not ms_is_raja_company"
                       options="{'no_create_edit': True}"
                       placeholder="For the attention of..."/>
            </field>
        </field>
    </record>

    <!-- The client's Odoo build (19.0+e) declares price_unit with NO fixed
         precision, so Decimal Accuracy > Product Price no longer reaches it and a
         price stored as 1.0211 is shown in full. Pinning the column here fixes
         the DISPLAY only - stored values keep their precision and no existing
         data is touched, which is the deliberate choice over re-attaching the
         field precision (that would round live prices irreversibly). -->
    <record id="view_order_form_price_unit_digits" model="ir.ui.view">
        <field name="name">sale.order.form.price.unit.digits</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
