<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Attn To" under the customer address on the quotation / sale order PDF.

         Printed only when the field is filled, and only for the Raja group
         companies (doc.ms_is_raja_company reads the ORDER's own company).

         The customer's TRN is NOT added here: Odoo already prints it in this
         same block, gated on the customer having one, using the country's own VAT
         label ("TRN" for the UAE). The client wants TRN first, so Attn To is
         anchored after that paragraph; with no TRN it simply follows the address. -->
    <template id="report_saleorder_document_attn_to" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']/p[@t-if='doc.partner_id.vat']" position="after">
            <p t-if="doc.ms_is_raja_company and doc.ms_attn_to_id" class="mb-0">
                Attn To: <span t-field="doc.ms_attn_to_id.name"/>
            </p>
        </xpath>
    </template>

    <!-- Quantity and Unit Price printed with 2 decimals, Raja group companies only.

         DISPLAY ONLY - the stored values keep every decimal they have, and the
         Decimal Accuracy settings (Product Price and Product Unit are both 3
         here) are untouched, so every other document and every other company
         prints exactly what it printed before.

         t-options takes an EXPRESSION, so the options dict is decided once per
         document and handed to the cells as a variable: an empty dict leaves a
         t-field on its normal behaviour, which is what the other companies get.
         The two t-sets go before the address block, which is above the lines
         table, so they are in scope inside the line loop.

         Note for the client: a price that really carries a third decimal now
         prints rounded (1.021 -> 1.02). On the 2026-09-28 data that is 178 Raja
         order lines. Nothing is rounded in the database and the order totals
         still come from the full values, so a printed unit price x quantity may
         not exactly match the printed line total on those lines. -->
    <template id="report_saleorder_document_two_decimals" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']" position="before">
            <t t-set="ms_2dp" t-value="{'widget': 'float', 'precision': 2} if doc.ms_is_raja_company else {}"/>
            <t t-set="ms_2dp_price" t-value="{'widget': 'float', 'precision': 2} if doc.ms_is_raja_company else {'widget': 'float', 'decimal_precision': 'Product Price'}"/>
            <t t-set="ms_2dp_qty" t-value="{'widget': 'float', 'precision': 2} if doc.ms_is_raja_company else {'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
        </xpath>
        <!-- QUANTITY column, and the second line it prints when the sales UoM
             differs from the product's own UoM. -->
        <xpath expr="//td[@name='td_product_quantity']/span[@t-field='line.product_uom_qty']" position="attributes">
            <attribute name="t-options">ms_2dp</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']//span[@t-esc='quantity_in_product_uom']" position="attributes">
            <attribute name="t-options">ms_2dp_qty</attribute>
        </xpath>
        <!-- UNIT PRICE column: the plain price, and the one core prints instead
             when the line carries a negative discount. -->
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">ms_2dp</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-out]" position="attributes">
            <attribute name="t-options">ms_2dp_price</attribute>
        </xpath>
    </template>

    <!-- Footer on the quotation / sale order PDF for the Raja group companies.

         The footer is normally one HTML blob, res.company.report_footer, edited
         in Settings > Companies. Overriding it here rather than editing that
         field keeps every other document - delivery notes, invoices, purchase
         orders, portal pages and outgoing mail - on the company's real details.

         "'ms_is_raja_company' in o" is how core itself tests for a field on the
         document (see web.external_layout), and it doubles as the scope: only
         sale.order carries that field, so no other report can match.

         The TRN is kept from each company's own VAT - only the three values the
         client gave are replaced. Note this patches external_layout_boxed, the
         layout all three Raja companies use; switching a company to another
         layout would quietly bring the old footer back. -->
    <template id="external_layout_boxed_raja_sale_footer" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[hasclass('o_footer_content')]//span[@t-field='company.report_footer']" position="replace">
            <t t-if="o and 'ms_is_raja_company' in o and o.ms_is_raja_company">
                <!-- Same shape as the stored footer it replaces: one centred
                     paragraph, the website as a real link so it renders blue and
                     stays clickable, then the company's own TRN after a nbsp. -->
                <p style="text-align: center;">+971582563078 sc1@rajacompany.com <a href="https://safetyplusworld.com">https://safetyplusworld.com</a><t t-if="company.vat">&#160;<t t-out="company.vat"/></t></p>
            </t>
            <t t-else="">
                <span t-field="company.report_footer"/>
            </t>
        </xpath>
    </template>

</odoo>
