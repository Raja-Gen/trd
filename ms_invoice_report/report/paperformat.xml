<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Margins are all zero and the 10 mm side margins live inside the template,
         so the pale band at the foot of the page can bleed to the paper edge.
         dpi 96 + disable_shrinking is what makes one CSS px come out as exactly
         one device pixel, which is what the traced coordinates assume. -->
    <record id="paperformat_ms_invoice" model="report.paperformat">
        <field name="name">MS Invoice A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">26</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

</odoo>
