<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
       <!--  <report
            id="report_licences_certificate_history"
            model="record.licences"
            string="Licences History"
            report_type="qweb-pdf"
            name="odoo_licences_certificates.licences_record_report_templete"
            file="odoo_licences_certificates.licences_record_report_templete"
