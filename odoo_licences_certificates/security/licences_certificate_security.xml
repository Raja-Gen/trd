<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_licences_certificate" model="res.groups">
            <field name="name">Licences Certificate Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <!-- <record id="ir_rule_licences_certificate_employee" model="ir.rule">
            <field name="name">Certificate Employees</field>
            <field name="model_id" ref="model_record_certificate"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record> -->
        <record id="ir_rule_licences_certificate_employee" model="ir.rule">
            <field name="name">Certificate Employees</field>
            <field name="model_id" ref="model_record_certificate"/>
            <field name="domain_force">['|','|',
                ('partner_id', '=', user.partner_id.id),
                ('employee_id', '=', user.employee_id.id),
                ('custom_user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record>
        <record id="ir_rule_licences_certificate_portal" model="ir.rule">
            <field name="name">Portal Employees</field>
            <field name="model_id" ref="model_record_certificate"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_portal'))]"/>
        </record>
        <record id="ir_rule_licences_certificate_manager" model="ir.rule">
            <field name="name">Licences Certificate</field>
            <field name="model_id" ref="model_record_certificate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('odoo_licences_certificates.group_licences_certificate'))]"/>
        </record>



        <record id="ir_rule_licences_history_employee" model="ir.rule">
            <field name="name">Portal User</field>
            <field name="model_id" ref="model_record_licences"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_portal'))]"/>
        </record>
        <!-- <record id="ir_rule_licences_employee" model="ir.rule">
            <field name="name">Licences Employees</field>
            <field name="model_id" ref="model_record_licences"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record> -->
        <record id="ir_rule_licences_employee" model="ir.rule">
            <field name="name">Licences Employees</field>
            <field name="model_id" ref="model_record_licences"/>
            <field name="domain_force">['|','|',
                ('partner_id', '=', user.partner_id.id),
                ('employee_id', '=', user.employee_id.id),
                ('custom_user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4,ref('base.group_user'))]"/>
        </record>
        <record id="ir_rule_licences_history_manager" model="ir.rule">
            <field name="name">Licences History Manager</field>
            <field name="model_id" ref="model_record_licences"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4,ref('odoo_licences_certificates.group_licences_certificate'))]"/>
        </record>
        <record model="ir.rule" id="record_certificate_multi_company_rule">
            <field name="name">Record Certificate multi-company</field>
            <field name="model_id" ref="model_record_certificate"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <record model="ir.rule" id="record_licences_multi_company_rule">
            <field name="name">Record Licences multi-company</field>
            <field name="model_id" ref="model_record_licences"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
