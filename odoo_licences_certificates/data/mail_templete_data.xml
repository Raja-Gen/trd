      <record id="odoo_licences_record_email_templte_history_view" model="mail.template">
          <field name="name">Licences</field>
          <!-- <field name="email_from">${object.user_id.company_id.email}</field>
          <field name="subject">${ctx['name']}</field> -->
          <field name="email_from">{{object.user_id.company_id.email}}</field>
          <field name="subject">{{ctx['name']}}</field>
          <field name="model_id" ref="odoo_licences_certificates.model_record_licences"/>
          <!-- <field name="email_to" >${object.user_id.email}</field> -->
          <field name="email_to" >{{object.user_id.email}}</field>
          <field name="auto_delete" eval="True"/>
          <field name="body_html" type="html">
            <div>
               Hello <!-- ${object.user_id.name} -->
               <t t-out="object.user_id.name"/>,
               <ul>Your License has been Issused by <!-- ${object.issuses_by.name} --><t t-out="object.issuses_by.name"/>.License Details are as below:
                <br></br>
                <p></p></ul>
                <table border="1" style="width:50%;">
                    <tr>
                      <td colspan = "3" style="text-align:center;"><b>License No:</b><!-- ${object.number} -->
                      <t t-out="object.number"/>
                    </td>
                    </tr>
                   <tr>
                      <td colspan = "3"><b>Description:</b><!-- ${object.note or ''} --><t t-out="object.note"/></td>
                   </tr>
                   <tr>
                      <th style="text-align:left;">Start Date</th>
                      <th style="text-align:left;">Expire Date</th>
                   </tr>
                   <tr>
                      <td style="text-align:left;width:25%; "><!-- ${(object.start_date).strftime('%m/%d/%Y')} -->
                        <t t-out="(object.start_date).strftime('%m/%d/%Y')"/>
                      </td>
                      <td style="text-align:left;width:25%;"><!-- ${(object.end_date).strftime('%m/%d/%Y')} -->
                        <t t-out="(object.end_date).strftime('%m/%d/%Y')"/>
                      </td>
                   </tr>
                   <tr>
                      <th style="text-align:left;width:25%;">Licence Types</th>
                      <th style="text-align:left;width:25%;">Status</th>
                   </tr>
                   <tr>
                      <td style="text-align:left;width:25%;"><!-- ${object.type_id.name} --><t t-out="object.type_id.name"/></td>
                      <td style="text-align:left;width:25%;"><!-- ${(object.state).upper()} -->
                        <t t-out="(object.state).upper()"/>
                     </td>
                   </tr>
               </table>
               <br/>
               <br/>
         
       </div>
          <font size="3">
               <p>Thank you,</p>
               <p><!-- ${object.company_id.name} -->
                 <t t-out="object.company_id.name"/>
               </p>
           </font>

              </field>
      </record>

