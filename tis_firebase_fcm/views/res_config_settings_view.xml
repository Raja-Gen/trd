<odoo>
    <record id="dba_inventory_configuration_views_inherit_login" model="ir.ui.view">
        <field name="name">dba.inventory.configuration.inherit.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="///div[@id='invite_users']" position="before">
                <h2>Firebase</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="firebase_json"/>
                                <div class="text-muted">
                                 <field name="firebase_json"/>
                                </div>
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>