<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- Petty Cash Reconciliation Wizard Views      -->
    <!-- ============================================ -->

    <!-- Reconciliation Wizard Form View -->
    <record id="view_petty_cash_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">petty.cash.reconcile.wizard.form</field>
        <field name="model">petty.cash.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconcile Petty Cash Voucher">
                <group>
                    <group string="Voucher Information">
                        <field name="voucher_id" readonly="1"/>
                        <field name="fund_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="paid_amount"/>
                    </group>
                    <group string="Receipt Information">
                        <field name="receipt_total"/>
                        <field name="variance_amount" class="oe_inline"/>
                        <field name="variance_type" widget="badge" decoration-success="variance_type == 'none'" decoration-warning="variance_type == 'overage'" decoration-danger="variance_type == 'shortage'"/>
                    </group>
                </group>
                <group string="Receipt Attachments">
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                </group>

<!--                <group string="Options" invisible="variance_type == 'none'">-->
<!--                    <field name="create_variance_entry"/>-->
<!--                    <div class="alert alert-info" role="alert" invisible="not create_variance_entry or variance_type == 'none'">-->
<!--                        <strong>Variance Entry:</strong>-->
<!--                        <span invisible="variance_type != 'shortage'">-->
<!--                            A journal entry will be created to record the cash shortage.-->
<!--                            The variance account will be debited and petty cash credited.-->
<!--                        </span>-->
<!--                        <span invisible="variance_type != 'overage'">-->
<!--                            A journal entry will be created to record the cash overage.-->
<!--                            The petty cash account will be debited and variance account credited.-->
<!--                        </span>-->
<!--                    </div>-->
<!--                </group>-->

                <separator string="Options" invisible="variance_type == 'none'"/>
                <field name="create_variance_entry" invisible="variance_type == 'none'"/>
                <div class="alert alert-info" role="alert" invisible="not create_variance_entry or variance_type == 'none'">
                    <strong>Variance Entry:</strong>
                    <span invisible="variance_type != 'shortage'">
                        A journal entry will be created to record the cash shortage.
                        The variance account will be debited and petty cash credited.
                    </span>
                    <span invisible="variance_type != 'overage'">
                        A journal entry will be created to record the cash overage.
                        The petty cash account will be debited and variance account credited.
                    </span>
                </div>
                <separator string="Notes"/>
                <field name="notes" nolabel="1" placeholder="Add any notes about this reconciliation..."/>
                <footer>
                    <button name="action_reconcile" type="object" string="Reconcile" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Reconciliation Wizard Action -->
    <record id="action_petty_cash_reconcile_wizard" model="ir.actions.act_window">
        <field name="name">Reconcile Voucher</field>
        <field name="res_model">petty.cash.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
