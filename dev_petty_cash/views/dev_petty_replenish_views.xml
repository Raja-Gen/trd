<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- Petty Cash Replenishment Views              -->
    <!-- ============================================ -->

    <!-- Replenish Tree View -->
    <record id="view_dev_petty_replenish_tree" model="ir.ui.view">
        <field name="name">dev.petty.replenish.tree</field>
        <field name="model">dev.petty.replenish</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Replenishments" decoration-info="state == 'draft'" decoration-warning="state == 'requested'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="requested_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="requested_by" widget="many2one_avatar_user"/>
                <field name="requested_date"/>
                <field name="approved_by" widget="many2one_avatar_user" optional="show"/>
                <field name="method" optional="show"/>
                <field name="move_id" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'requested'" decoration-primary="state == 'approved'" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Replenish Form View -->
    <record id="view_dev_petty_replenish_form" model="ir.ui.view">
        <field name="name">dev.petty.replenish.form</field>
        <field name="model">dev.petty.replenish</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Replenishment">
                <header>
                    <button name="action_request" type="object" string="Submit Request" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'requested'" groups="dev_petty_cash.group_petty_manager"/>
                    <button name="action_create_replenishment_move" type="object" string="Create Journal Entry" class="btn-primary" invisible="state != 'approved' or move_id" groups="dev_petty_cash.group_petty_manager"/>
                    <button name="action_mark_done" type="object" string="Mark as Done" class="btn-success" invisible="state != 'approved' or not move_id" groups="dev_petty_cash.group_petty_cashier"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ['done', 'cancelled']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state != 'cancelled'" groups="dev_petty_cash.group_petty_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,done"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_journal_line)d" type="action" class="oe_stat_button" icon="fa-book" invisible="not move_id" context="{'search_default_id': move_id}">
                            <span class="o_stat_text">Journal Entry</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Auto-generated" bg_color="text-bg-info" invisible="method != 'auto'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="fund_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="requested_amount" readonly="state not in ['draft', 'requested']"/>
                            <field name="update_float" force_save="1" readonly="1" invisible="1" />
                            <div colspan="2" class="alert alert-info mb-0 mt-2" role="alert" invisible="not update_float">
                                <i class="fa fa-info-circle me-2"/>
                                The requested amount exceeds the current fund deficit. This replenishment will automatically increase the <strong>Fund Float Amount</strong>.
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Tracking">
                            <field name="requested_by" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="requested_date" readonly="state != 'draft'"/>
                            <field name="method" readonly="1"/>
                        </group>
                    </group>
                    <group string="Source Override (Optional)" invisible="state in ['done', 'cancelled']">
                        <group>
                            <field name="source_journal_id" options="{'no_create': True}" readonly="state not in ['draft', 'requested', 'approved']"/>
                        </group>
                        <group>
                            <field name="source_account_id" options="{'no_create': True}" readonly="state not in ['draft', 'requested', 'approved']"/>
                        </group>
                    </group>
                    <group string="Approval" invisible="state == 'draft'">
                        <group>
                            <field name="approved_by" widget="many2one_avatar_user" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="1" placeholder="Additional notes..." readonly="state in ['done', 'cancelled']"/>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div> -->
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Replenish Search View -->
    <record id="view_dev_petty_replenish_search" model="ir.ui.view">
        <field name="name">dev.petty.replenish.search</field>
        <field name="model">dev.petty.replenish</field>
        <field name="arch" type="xml">
            <search string="Search Replenishments">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="requested_by"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_requested" domain="[('state', '=', 'requested')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Manual" name="filter_manual" domain="[('method', '=', 'manual')]"/>
                <filter string="Automatic" name="filter_auto" domain="[('method', '=', 'auto')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fund" name="group_fund" context="{'group_by': 'fund_id'}"/>
                    <filter string="Requested By" name="group_requested_by" context="{'group_by': 'requested_by'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'requested_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Replenish Action -->
    <record id="action_dev_petty_replenish" model="ir.actions.act_window">
        <field name="name">Replenishments</field>
        <field name="res_model">dev.petty.replenish</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dev_petty_replenish_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a replenishment request
            </p>
            <p>
                Request additional funds to replenish petty cash when
                the balance falls below the threshold.
            </p>
        </field>
    </record>

    <!-- Replenish Action - Pending -->
    <record id="action_dev_petty_replenish_pending" model="ir.actions.act_window">
        <field name="name">Pending Replenishments</field>
        <field name="res_model">dev.petty.replenish</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dev_petty_replenish_search"/>
        <field name="domain">[('state', 'in', ['requested', 'approved'])]</field>
    </record>

</odoo>
