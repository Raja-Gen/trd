<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- Petty Cash Voucher Views                    -->
    <!-- ============================================ -->

    <!-- Voucher Tree View -->
    <record id="view_dev_petty_voucher_tree" model="ir.ui.view">
        <field name="name">dev.petty.voucher.tree</field>
        <field name="model">dev.petty.voucher</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Vouchers" decoration-info="state == 'draft'" decoration-warning="state in ['requested', 'approved']" decoration-success="state == 'reconciled'" decoration-muted="state == 'cancelled'">
                <header>
                    <button name="action_approve_selected" type="object" string="Approve"
                            class="btn-primary"
                            groups="dev_petty_cash.group_petty_cashier"
                            confirm="Approve the selected pending vouchers? Only the ones you are authorised to approve will be processed."/>
                </header>
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="purpose" optional="show"/>
                <field name="amount" sum="Total Amount"/>
                <field name="attachment_ids" widget="petty_attachment_preview" string="Docs" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="approved_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="paid_by_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ['requested', 'approved']" decoration-success="state in ['paid', 'reconciled']" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Voucher Form View (Mobile Friendly) -->
    <record id="view_dev_petty_voucher_form" model="ir.ui.view">
        <field name="name">dev.petty.voucher.form</field>
        <field name="model">dev.petty.voucher</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Voucher">
                <header>
                    <button name="action_request" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'requested'" groups="dev_petty_cash.group_petty_cashier"/>
                    <button name="action_pay" type="object" string="Mark as Paid" class="btn-primary" invisible="state != 'approved'" groups="dev_petty_cash.group_petty_cashier"/>
                    <button name="action_reconcile" type="object" string="Reconcile" class="btn-primary" invisible="state != 'paid'" groups="dev_petty_cash.group_petty_cashier"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ['reconciled', 'cancelled']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state != 'cancelled'" groups="dev_petty_cash.group_petty_manager"/>
                    <button name="action_print_voucher" type="object" string="Print" class="btn-secondary" icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,paid,reconciled"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_journal_line)d" type="action" class="oe_stat_button" icon="fa-book" invisible="not payment_move_id" context="{'search_default_id': payment_move_id}">
                            <span class="o_stat_text">Journal Entry</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="fund_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="requester_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="requester_employee_id" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'" force_save="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Amount &amp; Accounting">
                            <field name="amount" class="oe_inline"/>
                            <field name="expense_category_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="analytic_account_id" options="{'no_create': True}" readonly="state not in ['draft', 'requested']" groups="analytic.group_analytic_accounting"/>
                        </group>
                    </group>
                    <separator string="Purpose"/>
                    <field name="purpose" nolabel="1" placeholder="Describe the purpose of this petty cash request..." readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Line Items" name="lines">
                            <field name="line_ids" readonly="state not in ['draft', 'requested']">
                                <list string="Voucher Lines" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="description"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="analytic_account_id" optional="hide" groups="analytic.group_analytic_accounting"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" string="Receipts &amp; Documents"/>
                            <group invisible="state != 'reconciled'">
                                <group string="Reconciliation Details">
                                    <field name="receipt_total"/>
                                    <field name="variance_amount"/>
                                    <field name="variance_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approval History" name="approval" invisible="state == 'draft'">
                            <group>
                                <group string="Approval">
                                    <field name="approved_by_id" widget="many2one_avatar_user" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                                <group string="Payment">
                                    <field name="paid_by_id" widget="many2one_avatar_user" readonly="1"/>
                                    <field name="paid_date" readonly="1"/>
                                    <field name="payment_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Voucher Kanban View -->
    <record id="view_dev_petty_voucher_kanban" model="ir.ui.view">
        <field name="name">dev.petty.voucher.kanban</field>
        <field name="model">dev.petty.voucher</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="requester_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="purpose"/>
                <progressbar field="state" colors='{"draft": "secondary", "requested": "warning", "approved": "info", "paid": "success", "reconciled": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="date"/>
                                        </span>
                                    </div>
                                    <strong class="float-end">
                                        <field name="amount" widget="monetary"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mb-1">
                                        <span class="text-muted">Fund:</span>
                                        <field name="fund_id"/>
                                    </div>
                                    <div class="text-truncate">
                                        <field name="purpose"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="requester_id" widget="many2one_avatar_user"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'secondary', 'requested': 'warning', 'approved': 'info', 'paid': 'success', 'reconciled': 'success', 'cancelled': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Voucher Search View -->
    <record id="view_dev_petty_voucher_search" model="ir.ui.view">
        <field name="name">dev.petty.voucher.search</field>
        <field name="model">dev.petty.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Petty Cash Vouchers">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="requester_id"/>
                <field name="purpose"/>
                <filter string="My Vouchers" name="filter_my_vouchers" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_requested" domain="[('state', '=', 'requested')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Reconciled" name="filter_reconciled" domain="[('state', '=', 'reconciled')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month" domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="filter_last_month" domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() - relativedelta(months=1, day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Has Variance" name="filter_variance" domain="[('variance_amount', '!=', 0)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fund" name="group_fund" context="{'group_by': 'fund_id'}"/>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Voucher Action - All -->
    <record id="action_dev_petty_voucher" model="ir.actions.act_window">
        <field name="name">Petty Cash Vouchers</field>
        <field name="res_model">dev.petty.voucher</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dev_petty_voucher_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new petty cash voucher request
            </p>
            <p>
                Request petty cash for small expenses. Attach receipts and
                track the approval and payment workflow.
            </p>
        </field>
    </record>

    <!-- Voucher Action - My Vouchers -->
    <record id="action_dev_petty_voucher_my" model="ir.actions.act_window">
        <field name="name">My Vouchers</field>
        <field name="res_model">dev.petty.voucher</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dev_petty_voucher_search"/>
        <field name="context">{'search_default_filter_my_vouchers': 1}</field>
    </record>

    <!-- Voucher Action - Pending Approval -->
    <record id="action_dev_petty_voucher_pending" model="ir.actions.act_window">
        <field name="name">Vouchers to Approve</field>
        <field name="res_model">dev.petty.voucher</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dev_petty_voucher_search"/>
        <field name="context">{'search_default_filter_requested': 1}</field>
    </record>

    <!-- Voucher Action - To Pay -->
    <record id="action_dev_petty_voucher_to_pay" model="ir.actions.act_window">
        <field name="name">Vouchers to Pay</field>
        <field name="res_model">dev.petty.voucher</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dev_petty_voucher_search"/>
        <field name="context">{'search_default_filter_approved': 1}</field>
    </record>

    <!-- Voucher Action - To Reconcile -->
    <record id="action_dev_petty_voucher_to_reconcile" model="ir.actions.act_window">
        <field name="name">Vouchers to Reconcile</field>
        <field name="res_model">dev.petty.voucher</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_dev_petty_voucher_search"/>
        <field name="context">{'search_default_filter_paid': 1}</field>
    </record>

</odoo>
