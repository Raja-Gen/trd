<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- Sequence Definitions                        -->
    <!-- ============================================ -->

    <!-- Voucher Sequence -->
    <record id="sequence_petty_voucher" model="ir.sequence">
        <field name="name">Petty Cash Voucher</field>
        <field name="code">dev.petty.voucher</field>
        <field name="prefix">PCV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Replenishment Sequence -->
    <record id="sequence_petty_replenish" model="ir.sequence">
        <field name="name">Petty Cash Replenishment</field>
        <field name="code">dev.petty.replenish</field>
        <field name="prefix">PCR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
