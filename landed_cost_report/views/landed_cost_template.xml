<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="landed_cost_report_template">
    <t t-call="web.basic_layout">
        <div class="page">
            <t t-set="o" t-value="purchase_order"/>

            <!-- HEADER -->
            <div class="header" style="margin-bottom: 10px;">
    <div class="row align-items-center">  <!-- FIX: vertical alignment -->
        
        <div class="col-2">
           <img t-if="o.company_id.logo" 
     t-att-src="image_data_uri(o.company_id.logo)"
     style="max-height: 110px; max-width: 100%; object-fit: contain; margin-top: -10px;" 
     alt="Logo"/>
        </div>

        <div class="col-10">

            <!-- Heading -->
            <h5 style="margin: 0; text-align: right;">GRN: Cost Report</h5>
            <div style="border-bottom: 2px solid black; margin-top: 5px;"></div>

            <!-- Left & Right content -->
            <div class="row" style="margin-top: 6px;">
                
                <!-- Left side -->
                <div class="col-4">
                    <h5 style="margin: 0; font-size: 12px;">
                        <t t-esc="o.company_id.name"/>
                    </h5>
                    <p style="margin: 0; font-size: 10px;">Raja Company Wll (Safety Plus)</p>
                </div>

                <!-- Right side -->
                <div class="col-8 text-end">
                    <p style="margin: 0; font-size: 11px;">
                        <strong>Date:</strong>
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%y')"/><br/>

                        <strong>Page:</strong>
                        <span class="page"/> / <span class="topage"/><br/>

                        <strong>User:</strong>
                        <span t-esc="user.name"/>
                    </p>
                </div>

            </div>

            <hr style="margin: 5px 0; border-top: 2px solid black;"/>
        </div>

    </div>
</div>

            <!-- INFO SECTION -->
            <div class="row" style="font-size: 11px; margin-bottom: 10px;">
                <div class="col-6">
                    <table class="table table-sm table-borderless" style="margin-bottom: 0;">
                        <tr>
                            <td style="width: 25%; padding: 1px;"><strong>Doc.#:</strong></td>
                            <td style="width: 25%; padding: 1px;"><span t-field="o.name"/></td>
                            <td style="width: 25%; padding: 1px;"><strong>Vendor:</strong></td>
                            <td style="width: 25%; padding: 1px;"><span t-field="o.partner_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 1px;"><strong>PO#:</strong></td>
                            <td style="padding: 1px;"><span t-field="o.name"/></td>
                            <td style="padding: 1px;"><strong>Date:</strong></td>
                            <td style="padding: 1px;"><span t-esc="context_timestamp(o.date_order).strftime('%d-%m-%Y')"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 1px;"><strong>Ref.#:</strong></td>
                            <td style="padding: 1px;"><span t-field="o.partner_ref"/></td>
                            <td style="padding: 1px;"><strong>Currency:</strong></td>
                            <td style="padding: 1px;"><span t-field="o.currency_id.name"/></td>
                        </tr>
                    </table>
                </div>

                <div class="col-6">
                    <table class="table table-sm table-borderless" style="margin-bottom: 0;">
                        <tr>
                            <td style="width: 25%; padding: 2px;"><strong>Status:</strong></td>
                            <td style="padding: 1px;"><span t-field="o.state"/></td>
                            <td style="padding: 1px;"><strong>Exch. Rt.:</strong></td>
                            <td style="padding: 1px;">
                                <span t-esc="'%.3f' % (o.currency_id.rate if (o.currency_id and o.currency_id.rate) else 1.0)"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- PRODUCTS TABLE -->
            <table class="table table-sm table-bordered" style="font-size: 11px; border-collapse: collapse; width: 100%;">
                <thead style="background-color: #003366; color: white;">
                    <tr>
                        <th rowspan="2" class="text-left align-middle">Item Code</th>
                        <th rowspan="2" class="text-center align-middle">UOM</th>
                        <th rowspan="2" class="text-center align-middle">Qty<br/>Ordered</th>
                        <th rowspan="2" class="text-center align-middle">Qty<br/>Received</th>
                        <th rowspan="2" class="text-center align-middle">Expected<br/>Value</th>

                        <th colspan="2" class="text-center">Actual Value FC</th>
                        <th colspan="2" class="text-center">Actual Value BC</th>
                        <th colspan="2" class="text-center">Landed Value</th>
                    </tr>
                    <tr style="background-color: #003366; color: white;">
                        <th class="text-center">Unit Price</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Unit Price</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Unit Price</th>
                        <th class="text-center">Total</th>
                    </tr>
                </thead>

               <tbody>

    <!-- Initialize totals -->
    <t t-set="total_qty_ordered"  t-value="0"/>
    <t t-set="total_qty_received" t-value="0"/>
    <t t-set="total_expected"     t-value="0"/>
    <t t-set="total_actual_fc"    t-value="0"/>
    <t t-set="total_actual_bc"    t-value="0"/>
    <t t-set="total_landed"       t-value="0"/>

    <!-- Exchange rate -->
    <t t-set="exchange_rate" t-value="(o.currency_id.rate or 1.0)"/>

    <t t-foreach="o.order_line" t-as="line">

        <!-- Safe values -->
        <t t-set="qty_ordered"   t-value="line.product_uom_qty or 0"/>
        <t t-set="qty_received"  t-value="line.qty_received or 0"/>
        <t t-set="fc_unit"       t-value="line.price_unit or 0"/>
        <t t-set="fc_total"      t-value="line.price_subtotal or 0"/>
        <t t-set="expected_total" t-value="line.price_total or 0"/>

        <!-- Base currency -->
        <t t-set="bc_unit"  t-value="fc_unit * exchange_rate"/>
        <t t-set="bc_total" t-value="fc_total * exchange_rate"/>

        <!-- Landed cost -->
        <t t-set="svl" t-value="line.move_ids.stock_valuation_layer_ids"/>
        <t t-set="adj_line"
           t-value="svl and svl.stock_landed_cost_id.valuation_adjustment_lines.filtered(lambda a: a.product_id.id == line.product_id.id)"/>

      <t t-set="landed_extra_per_unit"
   t-value="(adj_line and adj_line[0].quantity and (adj_line[0].additional_landed_cost / adj_line[0].quantity)) or 0"/>

        <!-- If landed available -->
        <t t-if="landed_extra_per_unit">
            <t t-set="landed_unit"  t-value="bc_unit + landed_extra_per_unit"/>
            <t t-set="landed_total" t-value="landed_unit * qty_received"/>
        </t>
        <t t-else="">
            <t t-set="landed_unit"  t-value="0"/>
            <t t-set="landed_total" t-value="0"/>
        </t>

        <!-- Accumulate totals -->
        <t t-set="total_qty_ordered"  t-value="total_qty_ordered  + qty_ordered"/>
        <t t-set="total_qty_received" t-value="total_qty_received + qty_received"/>
        <t t-set="total_expected"     t-value="total_expected     + expected_total"/>
        <t t-set="total_actual_fc"    t-value="total_actual_fc    + fc_total"/>
        <t t-set="total_actual_bc"    t-value="total_actual_bc    + bc_total"/>
        <t t-set="total_landed"       t-value="total_landed       + landed_total"/>

        <!-- Print row -->
        <tr>
            <td class="text-left" style="font-size: 9px;">
                <strong><span t-field="line.product_id.default_code"/></strong>
            </td>

            <td class="text-center"><span t-field="line.product_uom.name"/></td>

            <td class="text-right"><span t-esc="'%.2f' % qty_ordered"/></td>
            <td class="text-right"><span t-esc="'%.2f' % qty_received"/></td>

            <td class="text-right"><span t-esc="'%.3f' % expected_total"/></td>

            <td class="text-right"><span t-esc="'%.3f' % fc_unit"/></td>
            <td class="text-right"><span t-esc="'%.3f' % fc_total"/></td>

            <td class="text-right"><span t-esc="'%.3f' % bc_unit"/></td>
            <td class="text-right"><span t-esc="'%.3f' % bc_total"/></td>

            <td class="text-right"><span t-esc="'%.3f' % landed_unit"/></td>
            <td class="text-right"><span t-esc="'%.3f' % landed_total"/></td>
        </tr>

    </t>

    <!-- TOTAL ROW (OUTSIDE LOOP!!) -->
    <tr style="font-weight: bold; background-color: #f2f2f2;">
        <td colspan="2">TOTAL:</td>

        <td class="text-right"><span t-esc="'%.2f' % total_qty_ordered"/></td>
        <td class="text-right"><span t-esc="'%.2f' % total_qty_received"/></td>

        <td class="text-right"><span t-esc="'%.3f' % total_expected"/></td>

        <td></td>
        <td class="text-right"><span t-esc="'%.3f' % total_actual_fc"/></td>

        <td></td>
        <td class="text-right"><span t-esc="'%.3f' % total_actual_bc"/></td>

        <td></td>
        <td class="text-right"><span t-esc="'%.3f' % total_landed"/></td>
    </tr>

</tbody>

            </table>

            <div class="footer" style="margin-top: 20px; padding-top: 5px;">
                <p style="font-size: 10px; margin: 0;">*BC- Base Currency, FC- Foreign Currency, LLR- Last Landed Rate</p>
            </div>
        </div>
    </t>
</template>

</odoo>
