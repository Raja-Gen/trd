<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--Report Excel Extended -->
    <record model="ir.ui.view" id="action_inventory_age_extended_report_form">
        <field name="name">inventory.age.extended.form</field>
        <field name="model">inventory.age.extended</field>
        <field name="arch" type="xml">
            <form string="Excel Report">
                <group>
                    <group>
                        <field name="excel_file" readonly="1" filename="file_name" />
                    </group>
                    <group>
                        <field name="file_name" invisible="1" />
                    </group>
                </group>
                <footer>
                    <button string="Cancel" name="cancel" special="cancel" class="oe_highlight" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Report Excel Extened action -->
    <record id="action_inventory_age_report_extended" model="ir.actions.act_window">
        <field name="name">inventory.age.extended</field>
        <field name="res_model">inventory.age.extended</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="inventory_age_extended_report_tree" model="ir.ui.view">
        <field name="name">inventory.age.extended.tree</field>
        <field name="model">inventory.age.extended</field>
        <field name="arch" type="xml">
            <tree string="Stock Age Ratio" create="false">
                <field name="company" />
                <field name="products" />
                <field name="product_category" />
                <field name="stock_available" />
                <field name="value" />
                <field name="days" />
                <field name="oldest_qty" />
                <field name="oldest_value" />
                <field name="qty_ratio" />
                <field name="value_ratio" />
            </tree>
        </field>
    </record>

    <record id="inventory_age_extended_report_search" model="ir.ui.view">
        <field name="name">inventory.age.extended.search</field>
        <field name="model">inventory.age.extended</field>
        <field name="arch" type="xml">
            <search string="Stock Age Ratio">
                <field name="company" />
                <field name="products" />
                <field name="product_category" />

                <separator />

                <filter string="Product" context="{'group_by':'products'}" name="products_groupby" />
                <filter string="Product Category" context="{'group_by':'product_category'}" name="product_category_groupby" />
                <filter string="Company" context="{'group_by':'company'}" name="company_groupby" />
                <separator />
            </search>
        </field>
    </record>

    <record id="inventory_age_extended_report_graph" model="ir.ui.view">
        <field name="name">inventory.age.extended.report.graph</field>
        <field name="model">inventory.age.extended</field>
        <field name="arch" type="xml">
            <graph string="Stock Age Ratio" type="bar" stacked="False">
                <field name="company" type="col" />
                <field name="oldest_qty" type="row" />
                <field name="days" type="measure" />
            </graph>
        </field>
    </record>

    <!-- Report Wizard Form View -->
    <record id="inventory_age_wizard_form_view" model="ir.ui.view">
        <field name="name">inventory.age.report.wiz.form</field>
        <field name="model">inventory.age.report.wiz</field>
        <field name="arch" type="xml">
            <form string="Stock Age Report">
                <sheet string="Stock Age Report">

                    <group expand="0" string="Select Product And Categories">
                        <field name="category_ids" widget="many2many_tags" />
                        <field name="product_ids" widget="many2many_tags" />
                    </group>

                    <group expand="0" string="Select Company">
                        <field name="company_ids" widget="many2many_tags" />
                    </group>

                </sheet>
                <footer>
                    <button name="print_inventory_age_report" string="Excel" type="object" class="oe_highlight" />
                    <button name="tree_graph_report_view" string="Data" type="object" class="oe_highlight" />
                    <button name="tree_graph_report_view" string="Graph" type="object" class="oe_highlight" context="{'report_graph':True}" />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>

            </form>
        </field>
    </record>

    <!--Report Wizard Action View -->
    <record id="action_inventory_age_report_action" model="ir.actions.act_window">
        <field name="name">Stock Age Report</field>
        <field name="res_model">inventory.age.report.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- <menuitem id="bi_inventory_age_reports_report_menu" action="action_inventory_age_report_action"
                  parent="stock.menu_warehouse_report" sequence="5" /> -->


</odoo>