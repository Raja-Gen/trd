<?xml version="1.0"?>
<odoo>
    <record id="view_inventory_valuation_day_excel" model="ir.ui.view">
        <field name="name">view.inventory.valuation.report.excel </field>
        <field name="model">inventory.valuation.report.report.excel</field>
        <field name="arch" type="xml">
            <form string="Genrated xls File">
                <group>
                    <field name="file_name" invisible="1" />
                    <field name="excel_file" readonly="1" filename="file_name" />
                </group>
                <footer>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_date_wizard" model="ir.ui.view">
        <field name="name">inventory.valuation.report.wizard.view</field>
        <field name="model">inventory.valuation.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Valuation">
                <group colspan="2" col="2">
                    <group string="Company">
                        <field name="company_id" />
                    </group>
                    <group string="Warehouse">
                        <field name="warehouse" widget="many2many_tags" domain="[('company_id','=',company_id)]"/>
                    </group>
                </group>
                <group colspan="2" col="2">
                    <group string="Location">
                        <field name="location_id" domain="[('company_id','=',company_id)]"/>
                    </group>
                    <group string="Filter By" invisible="display_sum">
<!--                           attrs="{'invisible' : [('display_sum','=',True)]}">-->
                        <field name="filter_by" widget="radio" />

                    </group>
                    <group string="Valuation">
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="display_sum" />
                    </group>
                </group>
                <group string="Product" invisible="filter_by != 'product' or display_sum"/>
<!--                       attrs="{'invisible' : ['|',('filter_by','!=','product'),('display_sum','=',True)]}" />-->
                <field name="product_ids" domain="['|',('company_id','=',company_id), ('company_id','=',False)]" invisible="filter_by != 'product' or display_sum" context="{'tree_view_ref' : 'bi_all_inventory_analysis_reports.custom_tree_view'}"></field>
<!--                       attrs="{'invisible' : ['|',('filter_by','!=','product'),('display_sum','=',True)]}" -->
                <group string="Category" invisible="filter_by != 'categ' or display_sum"/>
<!--                       attrs="{'invisible' : ['|',('filter_by','!=','categ'),('display_sum','=',True)]}" />-->
                <field name="category" invisible="filter_by != 'categ' or display_sum">
<!--                       attrs="{'invisible' : ['|',('filter_by','!=','categ'),('display_sum','=',True)]}">-->
                    <tree>
                        <field name="name" />
                    </tree>
                </field>
                <footer>
                    <button string="Print Pdf" name="print_report" type="object" class="oe_highlight" />
                    or
                    <button string="Print Excel" name="print_exl_report" type="object" class="oe_highlight" />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="custom_tree_view" model="ir.ui.view">
        <field name="name">custom.tree.view</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="action_inventory_valuation_report_product_category" model="ir.actions.act_window">
        <field name="name">Inventory Valuation</field>
        <field name="res_model">inventory.valuation.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- <menuitem id="menu_inventory_valuation_report_product_category" name="Inventory Valuation Report" parent="stock.menu_warehouse_report" action="action_inventory_valuation_report_product_category" groups="stock.group_stock_manager,stock.group_stock_user" /> -->

</odoo>