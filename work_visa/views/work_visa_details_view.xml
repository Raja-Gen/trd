<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="work_visa_details_tree_view" model="ir.ui.view">
        <field name="name">work.visa.details.tree.view</field>
        <field name="model">work.visa.details</field>
        <field name="arch" type="xml">
           <tree>
                <field name="wvd_file_no" optional="hide"/>
                <field name="wvd_visa_fee" optional="show"/>
                <field name="wvd_visa_fee_payment_date" optional="show"/>
                <field name="wvd_visa_no" optional="show"/>
                <field name="wvd_moi_ref_no" optional="show"/>
                <field name="wvd_visa_issue_date" optional="show"/>
                <field name="wvd_visa_expiry_date" optional="hide"/>
                <field name="wvd_visa_status" optional="hide"/>
                <field name="wvd_visa_cancellation_date" optional="hide"/>
                <field name="wvd_reason_of_visa_cancellation" optional="hide"/>
                <field name="wvd_expected_date_of_arrival" optional="hide"/>
                <field name="wvd_date_of_arrival_ticket" optional="hide"/>
           </tree>
        </field>
    </record>

    <record id="work_visa_details_from_view" model="ir.ui.view">
        <field name="name">work.visa.details.form.view</field>
        <field name="model">work.visa.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Work Visa Details">
                        <group>
                            <field name="wvd_file_no"/>
                            <field name="wvd_visa_fee" required="1"/>
                            <field name="wvd_visa_fee_payment_date"/>
                            <field name="wvd_visa_no" required="1"/>
                            <field name="wvd_moi_ref_no"/>
                            <field name="wvd_visa_issue_date"/>
                            <field name="wvd_visa_expiry_date"/>
                        </group>
                        <group>
                            <field name="wvd_visa_status"/>
                            <field name="wvd_visa_cancellation_date"/>
                            <field name="wvd_reason_of_visa_cancellation"/>
                            <field name="wvd_expected_date_of_arrival"/>
                            <field name="wvd_date_of_arrival_ticket"/>
                        </group>                    
                    </group>
                 </sheet>
            </form>
        </field>
    </record>

    <record id="work_visa_details_action" model="ir.actions.act_window">
        <field name="name">Work Visa Details</field>
        <field name="res_model">work.visa.details</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="work_visa_details_tree_view"/>
    </record>

    <menuitem id="work_visa_details_menu"
        name="Work Visa Details"
        action="work_visa_details_action"
        parent="work_visa_menu"
        sequence = "4" />
</odoo>


