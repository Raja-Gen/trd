<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_details_tree_view" model="ir.ui.view">
        <field name="name">employee.details.tree.view</field>
        <field name="model">employee.details</field>
        <field name="arch" type="xml">
           <tree>
               <field name="ed_file_no" optional="show"/>
                <field name="ed_arabic_name" optional="show"/>
                <field name="ed_english_name" optional="show"/>
                <field name="ed_passport_no" optional="show"/>
                <field name="ed_passport_issue_date" optional="show"/>
                <field name="ed_passport_expiry_date" optional="show"/>
                <field name="ed_national_id_no" optional="hide"/>
                <field name="ed_nationality" optional="hide"/>
                <field name="ed_date_of_birth" optional="hide"/>
                <field name="ed_gender" optional="hide"/>
                <field name="ed_national_license_type" optional="hide"/>
                <field name="ed_national_license_issue" optional="hide"/>
                <field name="ed_national_license_expiry" optional="hide"/>
                <field name="ed_eduction" optional="hide"/>
                <field name="ed_contact_no" optional="hide"/>
                <field name="ed_email" optional="hide"/>
                <field name="ed_supplier_name" optional="hide"/>
                <field name="ed_supplier_mobile_no" optional="hide"/>
                <field name="ed_aproval_date" optional="hide"/>
           </tree>
        </field>
    </record>

    <record id="employee_details_from_view" model="ir.ui.view">
        <field name="name">employee.details.form.view</field>
        <field name="model">employee.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Employee Details">
                        <group>
                            <field name="ed_file_no" required="1"/>
                            <field name="ed_arabic_name"/>
                            <field name="ed_english_name"/>
                            <field name="ed_passport_no"/>
                            <field name="ed_passport_issue_date"/>
                            <field name="ed_passport_expiry_date"/>
                            <field name="ed_national_id_no"/>
                            <field name="ed_nationality"/>
                            <field name="ed_date_of_birth"/>
                            <field name="ed_gender"/>
                        </group>
                        <group>
                            <field name="ed_national_license_type"/>
                            <field name="ed_national_license_issue"/>
                            <field name="ed_national_license_expiry"/>
                            <field name="ed_eduction"/>
                            <field name="ed_contact_no"/>
                            <field name="ed_email"/>
                            <field name="ed_supplier_name"/>
                            <field name="ed_supplier_mobile_no"/>
                            <field name="ed_aproval_date"/>
                        </group>                    
                    </group>
                 </sheet>
            </form>
        </field>
    </record>

    <record id="employee_details_action" model="ir.actions.act_window">
        <field name="name">Employee Details</field>
        <field name="res_model">employee.details</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="employee_details_tree_view"/>
    </record>

    <menuitem id="employee_details_menu"
        name="Employee Details"
        action="employee_details_action"
        parent="work_visa_menu"
        sequence = "3" />
</odoo>


