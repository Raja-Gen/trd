<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_inherit_view_form_for_file_num" model="ir.ui.view">
        <field name="name">hr.employee.form.inherited</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_phone']" position="before">
                <field name="hm_file_no"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_inherit_view_tree_for_file_num" model="ir.ui.view">
        <field name="name">hr.employee.tree</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="hm_file_no" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

