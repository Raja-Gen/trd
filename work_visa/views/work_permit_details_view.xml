<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="work_permit_details_tree_view" model="ir.ui.view">
        <field name="name">work.permit.details.tree.view</field>
        <field name="model">work.permit.details</field>
        <field name="arch" type="xml">
           <tree>
                <field name="wpd_company_name" optional="show"/>
                <field name="wpd_occupation" optional="show"/>
                <field name="wpd_salary" optional="show"/>
                <field name="wpd_apply_entry_permit" optional="show"/>
                <field name="wpd_requesting_no" optional="show"/>
                <field name="wpd_file_no" optional="hide"/>
                <field name="wpd_requesting_status" optional="hide"/>
                <field name="wpd_date_of_issue_permit" optional="hide"/>
                <field name="wpd_reason_of_rejection" optional="hide"/>
                <field name="wpd_date_of_cancellation_permit" optional="hide"/>
           </tree>
        </field>
    </record>

    <record id="work_permit_details_from_view" model="ir.ui.view">
        <field name="name">work.permit.details.form.view</field>
        <field name="model">work.permit.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Work Permit Details">
                        <group>
                            <field name="wpd_company_name" required="1"/>
                            <field name="wpd_file_no"/>
                            <field name="wpd_occupation"/>
                            <field name="wpd_salary"/>
                            <field name="wpd_apply_entry_permit"/>
                            <field name="wpd_requesting_no"/>
                        </group>
                        <group>
                            <field name="wpd_requesting_status"/>
                            <field name="wpd_date_of_issue_permit"/>
                            <field name="wpd_reason_of_rejection"/>
                            <field name="wpd_date_of_cancellation_permit"/>
                        </group>                    
                    </group>
                 </sheet>
            </form>
        </field>
    </record>

    <record id="work_permit_details_action" model="ir.actions.act_window">
        <field name="name">Work Permit Details</field>
        <field name="res_model">work.permit.details</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="work_permit_details_tree_view"/>
    </record>

    <menuitem id="work_permit_details_menu"
        name="Work Permit Details"
        action="work_permit_details_action"
        parent="work_visa_menu"
        sequence = "4" />
</odoo>


