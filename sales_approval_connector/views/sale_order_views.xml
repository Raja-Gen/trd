<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    To add the additional state and fields to the sale order-->
   <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.approval.connector</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">


            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,sent"/>
            </xpath>

            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button name="action_confirm" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'draft'"/>
            </xpath>
             <xpath expr="//header/button[@id='action_confirm']/following-sibling::button[@name='action_confirm'][1]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                <field name="is_approval_allowed" invisible="1"/>
                <button name="action_direct_approve" type="object" string="Approve Request" class="btn-primary" invisible="state != 'approve' or not is_approval_allowed" />
                <button name="action_direct_reject" type="object" string="Reject" class="btn-primary" invisible="state != 'approve' or not is_approval_allowed" />

            </xpath>




            
            <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                    <button name="action_confirm" id="action_confirm" data-hotkey="q"
                    string="Confirm" class="btn-primary" type="object" context="{'validate_analytic': True}"
                    invisible="state not in ['approved']"/>
                <field name="is_approved" invisible="1"/>
            </xpath>
            
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'sent', 'sale','approved'] or not id</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Approval History" name="approval_history_page" invisible="not approval_history_ids">
                    <field name="approval_history_ids">
                        <list string="Approval History" editable="bottom">
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="note"/>
                            <field name="date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

