<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups" id="group_emp_appr">
        <field name="name">Document Approver</field>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="hr_document_request_user" model="ir.rule">
        <field name="name">Document Request:User</field>
        <field name="model_id" ref="alh_request_document.model_document_request"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="hr_document_request_manager" model="ir.rule">
        <field name="name">Document Request:Hr Manager</field>
        <field name="model_id" ref="alh_request_document.model_document_request"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager')),(4, ref('alh_request_document.group_emp_appr'))]"/>
    </record>


</odoo>