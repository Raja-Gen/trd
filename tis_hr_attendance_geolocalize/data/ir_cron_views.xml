<odoo>
    <!-- Scheduled Action to log out employees at 12 PM and re-check them in after 1 second -->
    <record id="ir_cron_log_out_and_check_in1" model="ir.cron">
        <field name="name">Log Out and Re-Check In at Noon</field>
        <field name="model_id"
               ref="model_hr_attendance"/> <!-- Make sure this model is correctly referenced -->
        <field name="state">code</field>
        <field name="code">model.auto_checkout_and_checkin()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1
        </field> <!-- Set the interval to 1 day -->
        <field name="interval_type">hours</field>
    </record>
        <record id="ir_cron_delete_old_records" model="ir.cron">
            <field name="name">Delete Old Notifications</field>
            <field name="model_id" ref="model_push_notification"/>
            <field name="state">code</field>
            <field name="code">model.delete_old_records()</field>
            <field name="user_id" ref="base.user_root"/> <!-- Superuser -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    <record id="ir_cron_attendance_reminders" model="ir.cron">
        <field name="name">Attendance Reminders</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.send_attendance_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>