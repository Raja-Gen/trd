<odoo>
    <record id="view_assign_hr_wizard_form" model="ir.ui.view">
        <field name="name">assign.hr.wizard.form</field>
        <field name="model">assign.hr.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign HR">
                <group>
                    <field name="company_id"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="hr_employee_id"/>
                </group>
                <footer>
                    <button name="action_assign_hr" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assign_hr_wizard" model="ir.actions.act_window">
        <field name="name">Assign HR</field>
        <field name="res_model">assign.hr.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_assign_hr_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>