<odoo>
    <record id="dba_res_user_inherit" model="ir.ui.view">
        <field name="name">dba.res.user.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
             <xpath expr="//page[@name='preferences']" position="after">
                <page name="user_office_buddy" string="User Token">
                    <group string="Office Buddy">
                        <field name="user_device_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>