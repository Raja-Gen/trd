<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee View -->
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group/group[@name='active_group']"
                   position="after">
                <group string="Work Location" name="work_location">
                    <field name="is_geofencing_needed"/>
                    <field name="latitude" invisible="not is_geofencing_needed"/>
                    <field name="longitude" invisible="not is_geofencing_needed"/>
                    <field name="range" invisible="not is_geofencing_needed"/>
                    <field name="is_multi_location" invisible="not is_geofencing_needed"/>
                        <field name="location_ids" nolabel="1"  invisible="not is_multi_location or not is_geofencing_needed">
                            <tree editable="bottom">
                                <field name="sequence" widget='handle'/>
                                <field name="name"/>
                                <field name="latitude"/>
                                <field name="longitude"/>
                                <field name="range"/>
                            </tree>
                        </field>
                </group>
            </xpath>
            <xpath expr="//page[@name='hr_settings']/group/group[@name='active_group']"
                   position="inside">
                <field name="hr_responsible_id"/>
            </xpath>

            <xpath expr="//field[@name='pin']" position="before">
                <field name="is_attendance_enabled"/>
                <field name="is_face_needed"/>
                <field name="is_passcode" readonly="is_face_needed == True"/>
                <field name="user_device_id"/>
                <field name="face_image"/>
                <field name="passcode" invisible="is_passcode == False"/>
                <field name="is_mood"/>
                <field name="work_mood" invisible="is_mood == False"/>
                <field name="is_reminder"/>
                <field name="check_in_reminder" string="Check in reminder" widget="float_time" invisible="not is_reminder"/>
                <field name="check_out_reminder" widget="float_time" invisible="not is_reminder"/>
            </xpath>
        </field>
    </record>
    <!--    Work Mood Storing Notebook-->
    <record id="hr_employee_work_mood_form" model="ir.ui.view">
        <field name="name">hr.employee.work.mood.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="employee_mood" string="Employee Mood">
                        <field name="current_work_mood_ids">
                            <tree editable="bottom">
                                <field name="work_date"/>
                                <field name="work_mood"/>
                            </tree>
                        </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_enable_face_needed" model="ir.actions.server">
        <field name="name">Enable Face Needed</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            records.action_enable_face_needed()
        </field>
    </record>
    <record id="action_disable_face_needed" model="ir.actions.server">
        <field name="name">Disable Face Needed</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            records.action_disable_face_needed()
        </field>
    </record>

    <record id="action_enable_geofencing" model="ir.actions.server">
        <field name="name">Enable Geofencing</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            records.action_enable_geofencing()
        </field>
    </record>

    <record id="action_disable_geofencing" model="ir.actions.server">
        <field name="name">Disable Geofencing</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            records.action_disable_geofencing()
        </field>
    </record>

    <record id="action_assign_hr" model="ir.actions.server">
        <field name="name">Assign HR</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            action = {
            'type': 'ir.actions.act_window',
            'res_model': 'assign.hr.wizard',
            'view_mode': 'form',
            'target': 'new',
            'context': {
            'default_employee_ids': [e.id for e in records],
            }
            }
        </field>
    </record>

</odoo>