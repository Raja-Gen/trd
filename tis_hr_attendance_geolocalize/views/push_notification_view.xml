<odoo>
    <!-- Course Form View -->
    <record id="view_push_notification_form" model="ir.ui.view">
        <field name="name">push.notification.form</field>
        <field name="model">push.notification</field>
        <field name="arch" type="xml">
            <form string="Push Notification">
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="user_id"/>
                        <field name="employee_id"/>
                        <field name="description"/>
                        <field name="type"/>
                        <field name="notification_type"/>
                        <field name="screen_type"/>
                        <field name="is_marked"/>
                        <field name="recid"/>
                        <field name="created_dates"/>
                        <field name="action_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Course list View -->

    <record id="view_push_notification_tree" model="ir.ui.view">
        <field name="name">push.notification.tree</field>
        <field name="model">push.notification</field>
        <field name="arch" type="xml">
            <tree string="Push Notification">
                <field name="create_date"/>
                <field name="title"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="description"/>
                <field name="type"/>
                <field name="is_marked"/>
            </tree>
        </field>
    </record>


    <!-- Course Action -->

    <record id="action_push_notification" model="ir.actions.act_window">
        <field name="name">Push Notification</field>
        <field name="res_model">push.notification</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="push_notification_menu" name="Push Notification"
              parent="hr.menu_human_resources_configuration"
              action="action_push_notification"/>
</odoo>
