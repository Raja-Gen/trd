<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherited_assignment" model="ir.ui.view">
        <field name="name">project.task.form.inherited.assignment</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="readonly">use_employee_assignment</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="use_employee_assignment"/>
                <field name="assigned_employee_ids" widget="many2many_tags" invisible="not use_employee_assignment" required="use_employee_assignment"/>
            </xpath>
        </field>
    </record>
</odoo>
