<odoo>
    <data>

        <!-- Inherit the existing mail.mail.form view -->
        <record model="ir.ui.view" id="view_mail_form_inherit">
            <field name="name">mail.mail.form.inherit</field>
            <field name="model">mail.mail</field>
            <field name="inherit_id" ref="mail.view_mail_form"/>  <!-- Inherit the original view -->
            <field name="arch" type="xml">
                <!-- Add the employee field under the existing group or section -->
                <xpath expr="//group" position="inside">
                    <field name="employee_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
