<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Product Brand Search View -->
        <record id="view_product_brand_search" model="ir.ui.view">
            <field name="name">product.brand.search</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <search string="Search Product Brands">
                    <field name="name" string="Brand Name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <group>
                        <filter string="Company" name="groupby_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Product Brand Tree View -->
        <record id="view_product_brand_tree" model="ir.ui.view">
            <field name="name">product.brand.tree</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <list string="Product Brands">
                    <field name="sequence" widget="handle" optional="show"/>
                    <field name="name"/>
                    <field name="products_count" string="Products"/>
                    <field name="company_id" optional="show"/>
                    <field name="active" widget="boolean_toggle" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Product Brand Form View -->
        <record id="view_product_brand_form" model="ir.ui.view">
            <field name="name">product.brand.form</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <form string="Product Brand">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible ="active"/>
                        <field name="logo" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="e.g. AwesomeBrand"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="products_count" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products" name="products">
                                <group>
                                    <field name="product_ids" string="Products" readonly="0"
                                           domain="[('brand_id', '=', False), ('company_id', 'in', [False, company_id])]"
                                           widget="many2many_tags"/>
                                </group>
                                <field name="product_ids" readonly="1"
                                       domain="[('brand_id', 'in', False), ('company_id', 'in', [False, company_id])]">
                                    <list>
                                        <field name="default_code"/>
                                        <field name="name"/>
                                        <field name="categ_id"/>
                                        <field name="list_price"/>
                                        <field name="standard_price"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Add a description for this brand..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Product Brand Kanban View (Optional but nice to have) -->
        <record id="view_product_brand_kanban" model="ir.ui.view">
            <field name="name">product.brand.kanban</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="products_count"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <aside class="pe-2">
                                <img t-att-src="kanban_image('product.brand', 'logo', record.id.raw_value)" alt="Brand Logo" class="o_image_64_max"/>
                            </aside>
                            <main>
                                <strong class="fs-5">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-2">
                                    <button name="action_view_products" type="object" class="btn btn-secondary btn-sm">
                                        <field name="products_count"/> Products
                                    </button>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Product Brand Action -->
        <record id="action_product_brand" model="ir.actions.act_window">
            <field name="name">Product Brands</field>
            <field name="res_model">product.brand</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_product_brand_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new product brand.
                </p><p>
                    Manage the brands of your products. You can assign a brand to each product template.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <!-- Under Inventory > Configuration > Products > Product Brands -->
        <menuitem
            id="menu_product_brand_config"
            name="Product Brands"
            action="action_product_brand"
            parent="stock.menu_stock_config_settings"
            groups="stock.group_stock_manager"
            sequence="15"/>

        <!-- under Sales > Configuration > Products > Product Brands -->
        <menuitem
            id="menu_product_brand_config_sales"
            name="Product Brands"
            action="action_product_brand"
            parent="sale.prod_config_main"
            sequence="30"
            groups="stock.group_stock_manager"/>
    </data>
</odoo>
