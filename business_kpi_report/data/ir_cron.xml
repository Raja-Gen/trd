<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">        
        <record id="ir_cron_kpi_report" model="ir.cron">
            <field name="name">Daily Business KPI Report</field>
            <field name="model_id" ref="business_kpi_report.model_as_kpi"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_kpi_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + relativedelta(hour=23, minute=45, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record> 
    </data>

</odoo>
