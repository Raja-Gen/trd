<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="ir_cron_concierge_deadline_reminder" model="ir.cron">
    <field name="name">Concierge Deadline Reminder</field>
    <field name="model_id" ref="model_concierge_request"/>
    <field name="state">code</field>
    <field name="code">model.send_deadline_alerts()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
    <field name="doall">False</field>
  </record>
</odoo>
