<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Feedback Tree View -->
    <record id="view_concierge_feedback_tree" model="ir.ui.view">
        <field name="name">concierge.feedback.tree</field>
        <field name="model">concierge.feedback</field>
        <field name="arch" type="xml">
            <tree>
                <field name="request_id"/>
                <field name="rating"/>
                <field name="submitted_by"/>
                <field name="submitted_on"/>
            </tree>
        </field>
    </record>

    <!-- Feedback Form View -->
    <record id="view_concierge_feedback_form" model="ir.ui.view">
        <field name="name">concierge.feedback.form</field>
        <field name="model">concierge.feedback</field>
        <field name="arch" type="xml">
            <form string="Concierge Feedback">
                <sheet>
                    <group>
                        <field name="request_id" domain="[('state', 'in', ('done', 'cancelled'))]" options="{'no_create_edit': True, 'no_create': True}"/>
                        <field name="rating"/>
                        <field name="comment"/>
                        <field name="submitted_by" readonly="1"/>
                        <field name="submitted_on" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Feedback Search View -->
    <record id="view_concierge_feedback_search" model="ir.ui.view">
        <field name="name">concierge.feedback.search</field>
        <field name="model">concierge.feedback</field>
        <field name="arch" type="xml">
            <search string="Search Feedback">
                <field name="request_id"/>
                <field name="rating"/>
                <field name="submitted_by"/>
                <field name="submitted_on"/>

                <group expand="0" string="Group By">
                    <filter string="Rating" name="group_rating" context="{'group_by': 'rating'}"/>
                    <filter string="Submitted By" name="group_user" context="{'group_by': 'submitted_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Feedback Graph View -->
    <record id="view_concierge_feedback_graph" model="ir.ui.view">
        <field name="name">concierge.feedback.graph</field>
        <field name="model">concierge.feedback</field>
        <field name="arch" type="xml">
            <graph string="Satisfaction Rating" type="bar">
                <field name="rating" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>


    <!-- Action for Feedback -->
    <record id="action_concierge_feedback" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">concierge.feedback</field>
        <field name="view_mode">tree,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No feedback yet. Make sure your concierge team follows up!</p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_concierge_feedback" name="Feedback" parent="menu_concierge_root"
              action="action_concierge_feedback" sequence="20"/>

</odoo>