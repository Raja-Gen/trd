<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_concierge_request_form" model="ir.ui.view">
        <field name="name">concierge.request.form</field>
        <field name="model">concierge.request</field>
        <field name="arch" type="xml">
            <form string="Concierge Request">
                <header>
                    <field name="state" widget="statusbar" clickable="1" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state!='draft'"/>
                            <field name="assigned_to" readonly="state!='draft'"/>
                            <field name="category" readonly="state!='draft'"/>
                        </group>
                        <group>
                            <field name="priority" readonly="state!='draft'"/>
                            <field name="request_date" readonly="state!='draft'"/>
                            <field name="deadline" readonly="state!='draft'"/>
                            <field name="is_confidential" readonly="state!='draft'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <separator name="concierge_description" string="Description"/>
                            <field name="description" nolabel="1" colspan="2" readonly="state!='draft'"/>
                        </group>
                        <group>
                            <separator name="concierge_feedback" string="Feedback"/>
                            <field name="feedback" nolabel="1" colspan="2" readonly="state!='draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_concierge_request_tree" model="ir.ui.view">
        <field name="name">concierge.request.tree</field>
        <field name="model">concierge.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="assigned_to"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_concierge_request_search" model="ir.ui.view">
        <field name="name">concierge.request.search</field>
        <field name="model">concierge.request</field>
        <field name="arch" type="xml">
            <search string="Search Requests">
                <field name="name"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="assigned_to"/>
                <field name="requester_id"/>
                <field name="deadline"/>

                <filter string="My Requests" name="my_requests" domain="[('requester_id','=',uid)]"/>
                <filter string="Urgent" name="urgent" domain="[('priority','=','3')]"/>
                <filter string="Overdue" name="overdue" domain="[('deadline','&lt;',context_today())]"
                        help="Deadline has passed."/>

                <group expand="0" string="Group By">
                    <filter string="Assigned To" name="group_assigned" context="{'group_by':'assigned_to'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by':'priority'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_concierge_request_graph" model="ir.ui.view">
        <field name="name">concierge.request.graph</field>
        <field name="model">concierge.request</field>
        <field name="arch" type="xml">
            <graph string="Overdue Tasks" type="bar">
                <field name="assigned_to" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>


    <!-- Action -->
    <record id="action_concierge_request" model="ir.actions.act_window">
        <field name="name">Concierge Requests</field>
        <field name="res_model">concierge.request</field>
        <field name="view_mode">tree,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first concierge request</p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_concierge_root" name="Concierge" sequence="10"/>
    <menuitem id="menu_concierge_request" name="Requests" parent="menu_concierge_root"
              action="action_concierge_request"/>
</odoo>
