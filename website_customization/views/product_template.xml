<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_inherit_freeze" model="ir.ui.view">
        <field name="name">product.template.form.freeze.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group>
                    <field name="freeze_stock"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_website_document" model="ir.ui.view">
        <field name="name">product.template.form.website.document</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="extra_info" position="inside">
                <field name="is_ibuysafety_company" invisible="1"/>
                <field name="website_document_name" invisible="1"/>
                <field name="website_document" filename="website_document_name"
                       invisible="not is_ibuysafety_company"/>
            </group>
        </field>
    </record>
</odoo>
