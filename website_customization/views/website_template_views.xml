<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_sale_product_extension" inherit_id="website_sale.cta_wrapper">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-if="not product.freeze_stock">
                <!-- Quantity of the *selected variant*, kept in sync by
                     website_customization/static/src/js/variant_availability.js -->
                <t
                    t-set="variant_qty"
                    t-value="combination_info.get('website_variant_qty_available', 0.0)"
                />
                <div t-attf-class="o_wc_variant_availability o_not_editable text-success mt-3 #{'' if variant_qty &gt; 0 else 'd-none'}">
                    <span>Available: </span>
                    <span
                        class="o_wc_variant_available_qty"
                        t-out="combination_info.get('website_variant_qty_available_str', '0')"
                    />
                </div>
            </t>
        </xpath>
    </template>


    <template id="website_sale_product_disable_add_to_cart" inherit_id="website_sale.cta_wrapper">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-attf-class" add="{{'opacity-50 pe-none' if product.freeze_stock else ''}}" separator=" "/>
        </xpath>

       <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-if="product.freeze_stock">
                <p class="text-warning mt-2">
                    <strong>Sales temporarily disabled for this product.</strong>
                </p>
            </t>
        </xpath>

    </template>

    <template id="website_sale_product_document" inherit_id="website_sale.product">
        <xpath expr="//t[@t-call='website_sale.product_terms_and_conditions']" position="after">
            <div t-if="website.is_ibuysafety_company and product.website_document" class="o_wc_product_document o_not_editable mt-3">
                <t t-set="document_url" t-value="'/web/content/product.template/%s/website_document?filename_field=website_document_name' % product.id"/>
                <i class="fa fa-file-text-o me-1" role="img" aria-label="Document"/>
                <a t-att-href="document_url" target="_blank" rel="noopener"
                   t-out="product.website_document_name or 'Product Document'"/>
                <a t-att-href="document_url" target="_blank" rel="noopener"
                   class="ms-2" title="Open in a new tab" aria-label="Open in a new tab">
                    <i class="fa fa-external-link"/>
                </a>
            </div>
        </xpath>
    </template>

    <template id="cart_free_delivery_progress" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@id='cart_products']" position="before">
            <!-- `js_cart_lines`: replaced together with the lines whenever a quantity changes -->
            <t t-set="free_delivery" t-value="website_sale_order and website_sale_order.website_order_line and website_sale_order._get_free_delivery_progress()"/>
            <div t-if="free_delivery" class="js_cart_lines o_wc_free_delivery card shadow-sm mb-4">
                <div class="card-body text-center">
                    <div class="fw-semibold mb-2">
                        Free delivery on orders over
                        <span class="text-primary" t-out="free_delivery['threshold']" t-options="{'widget': 'monetary', 'display_currency': free_delivery['currency']}"/>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height: 14px;" role="progressbar"
                             t-att-aria-valuenow="int(free_delivery['percent'])" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar progress-bar-striped bg-primary" t-attf-style="width: {{ free_delivery['percent'] }}%"/>
                        </div>
                        <i class="fa fa-truck fa-lg text-primary" role="img" aria-label="Delivery"/>
                    </div>
                    <div class="small mt-2">
                        <t t-if="free_delivery['remaining']">
                            Add at least
                            <strong class="text-primary" t-out="free_delivery['remaining']" t-options="{'widget': 'monetary', 'display_currency': free_delivery['currency']}"/>
                            more to get free shipping!
                        </t>
                        <t t-else="">Your order qualifies for free shipping!</t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="payment_on_account" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="before">
            <t t-set="on_account" t-value="website_sale_order._get_pay_on_account_info()"/>
            <div t-if="on_account" class="o_wc_pay_on_account card mb-3">
                <div class="card-body">
                    <h5 class="mb-1">Pay on Account</h5>
                    <p class="mb-3">
                        Available credit:
                        <strong t-out="on_account['available']" t-options="{'widget': 'monetary', 'display_currency': on_account['currency']}"/>
                    </p>
                    <form t-if="on_account['enough']" action="/shop/payment/on_account" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary">Place Order on Account</button>
                        <div class="small text-muted mt-2">No payment now. We will invoice you on your agreed terms.</div>
                    </form>
                    <div t-else="" class="alert alert-warning mb-0">
                        This order is more than your available credit. Please pay with another method below, or contact us.
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
